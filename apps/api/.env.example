JWT_REFRESH_TTL_DAYS=7
DEFAULT_LOCALE=pt-BR
MFA_CIPHER_KEY=
MFA_BACKUP_PEPPER=
HIBP=0
AUTH_ISSUER=Malhet
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
HSTS=0
