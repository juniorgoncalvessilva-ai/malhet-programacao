# API Python (apps/api). O navegador chama /backend/api/* e o Next reescreve para cá.
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=/backend/api

# Dev sem login (a API também precisa de AUTH_DISABLED=true). Nunca em produção.
NEXT_PUBLIC_AUTH_DISABLED=false

# Analytics do kit (desligados por padrão)
NEXT_PUBLIC_GA_ENABLED=false
NEXT_PUBLIC_GTM_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ENABLED=false
NEXT_PUBLIC_LOGROCKET_ENABLED=false
