# API Python (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Clerk (autenticação do starter kit). A API valida o JWT pelo JWKS do mesmo Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
# Opcional: template de JWT do Clerk com claims extras (ex.: email)
NEXT_PUBLIC_CLERK_JWT_TEMPLATE_NAME=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up

# Analytics do kit (desligados por padrão)
NEXT_PUBLIC_GA_ENABLED=false
NEXT_PUBLIC_GTM_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ENABLED=false
NEXT_PUBLIC_LOGROCKET_ENABLED=false

# Dev sem Clerk (não use em produção)
AUTH_DISABLED=false
NEXT_PUBLIC_AUTH_DISABLED=false
